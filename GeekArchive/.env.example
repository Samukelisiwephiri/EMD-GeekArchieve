NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# AI project analysis (server-side only - never prefix with NEXT_PUBLIC_).
# Without it, SMMEs see a clearly labelled basic estimate instead.
ANTHROPIC_API_KEY=

# Optional: raises GitHub's API limit for reading repos (60/hour without, 5,000 with).
# A fine-grained token with no extra permissions (public repos only) is enough.
GITHUB_TOKEN=
