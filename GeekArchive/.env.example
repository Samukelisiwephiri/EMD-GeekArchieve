NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# AI project analysis and recommendations (server-side only - never prefix with NEXT_PUBLIC_).
# Without it, organisations see clearly labelled basic estimates instead.
ANTHROPIC_API_KEY=

# Recommended: raises GitHub's API limit for reading repos (60/hour without, 5,000 with).
# A fine-grained token with no extra permissions (public repos only) is enough.
GITHUB_TOKEN=

# POPIA: your Information Officer's contact email, shown in the privacy notice.
NEXT_PUBLIC_PRIVACY_CONTACT=

# Only for a pitch demo without Supabase (fake sign-in, nothing saved). Never in production.
NEXT_PUBLIC_DEMO_MODE=
